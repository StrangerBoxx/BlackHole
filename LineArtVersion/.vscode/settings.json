{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "files.eol": "\n",
  "javascript.preferences.importModuleSpecifierEnding": "js",
  "search.exclude": {
    "**/node_modules": true,
    "dist": true,
    "android/app/build": true,
    "android/.gradle": true,
    "package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "android/.gradle/**": true,
    "android/app/build/**": true
  }
}
